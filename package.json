{
  "name": "rate-limiter-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade distributed rate limiter learning project with Redis, token bucket math, debug traces, and HTTP demos.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "scenario:burst": "tsx scripts/scenario-burst.ts",
    "scenario:steady": "tsx scripts/scenario-steady.ts",
    "scenario:multi-user": "tsx scripts/scenario-multi-user.ts",
    "scenario:redis-outage": "tsx scripts/scenario-redis-outage.ts",
    "scenario:compare-stores": "tsx scripts/scenario-compare-stores.ts",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down"
  },
  "keywords": [
    "rate-limiter",
    "token-bucket",
    "redis",
    "express",
    "learning"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "ioredis": "^5.5.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
